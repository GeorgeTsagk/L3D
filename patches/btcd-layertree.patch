+// Exercise the full Taproot path. Redefined opcodes must not cause the
+// OP_SUCCESS shortcut, including when hidden in an unexecuted branch.
+func TestLayerTreeActivation(t *testing.T) {
+	scripts := [][]byte{
+		{OP_CAT, OP_FALSE},
+		{OP_FALSE, OP_IF, OP_CAT, OP_ENDIF, OP_FALSE},
+		{OP_FALSE, OP_IF, OP_LAYERTREE_TX, OP_ENDIF, OP_FALSE},
+		{OP_FALSE, OP_IF, OP_LAYERTREE_TWEAKADD, OP_ENDIF, OP_FALSE},
+		{OP_FALSE, OP_IF, OP_CHECKSIGFROMSTACK, OP_ENDIF, OP_FALSE},
+	}
+	for _, script := range scripts {
+		if err := runLayerTreeScript(script, nil, ScriptVerifyWitness|ScriptVerifyTaproot|ScriptBip16, BaseLeafVersion); err != nil {
+			t.Fatalf("preactivation OP_SUCCESS: %v", err)
+		}
+		if err := runLayerTreeScript(script, nil, StandardVerifyFlags|ScriptVerifyLayerTree, BaseLeafVersion); err == nil {
+			t.Fatal("experimental invalid script accepted")
+		}
+	}
+	script := []byte{OP_CAT, 2, 'a', 'b', OP_EQUAL}
+	if err := runLayerTreeScript(script, [][]byte{[]byte("a"), []byte("b")}, StandardVerifyFlags|ScriptVerifyLayerTree, BaseLeafVersion); err != nil {
+		t.Fatal(err)
+	}
+	if err := runLayerTreeScript(script, [][]byte{[]byte("a"), []byte("b")}, StandardVerifyFlags, BaseLeafVersion); err == nil {
+		t.Fatal("policy accepted unactivated opcode")
+	}
+	// Unknown leaf versions retain the existing consensus behavior.
+	if err := runLayerTreeScript([]byte{OP_CAT, OP_FALSE}, nil, ScriptVerifyWitness|ScriptVerifyTaproot|ScriptBip16|ScriptVerifyLayerTree, 0xc4); err != nil {
+		t.Fatal(err)
+	}
+	// Legacy and segwit v0 cannot use the restored opcode.
+	tx := wire.NewMsgTx(2)
+	tx.AddTxIn(&wire.TxIn{})
+	vm, err := NewEngine([]byte{OP_0, OP_0, OP_CAT, OP_TRUE}, tx, 0, ScriptVerifyLayerTree, nil, nil, 0, nil)
+	if err == nil {
+		err = vm.Execute()
+	}
+	if err == nil {
+		t.Fatal("legacy CAT enabled")
+	}
+}
+
+func runLayerTreeScript(script []byte, stack [][]byte, flags ScriptFlags, version TapscriptLeafVersion) error {
+	_, key := btcec.PrivKeyFromBytes([]byte{1})
+	leaf := NewTapLeaf(version, script)
+	root := leaf.TapHash()
+	out := ComputeTaprootOutputKey(key, root[:])
+	pk, _ := PayToTaprootScript(out)
+	cb := ControlBlock{InternalKey: key, OutputKeyYIsOdd: out.SerializeCompressed()[0] == 3, LeafVersion: version}
+	control, err := cb.ToBytes()
+	if err != nil {
+		return err
+	}
+	tx := wire.NewMsgTx(2)
+	tx.AddTxIn(&wire.TxIn{Witness: append(append(wire.TxWitness{}, stack...), script, control)})
+	tx.AddTxOut(wire.NewTxOut(1, []byte{OP_TRUE}))
+	fetch := NewCannedPrevOutputFetcher(pk, 2)
+	vm, err := NewEngine(pk, tx, 0, flags, nil, NewTxSigHashes(tx, fetch), 2, fetch)
+	if err != nil {
+		return err
+	}
+	return vm.Execute()
+}
