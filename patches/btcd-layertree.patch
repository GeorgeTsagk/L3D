+// Official BIP340 vectors include empty, one-byte, 17-byte and 100-byte
+// messages as well as invalid points, parity and scalar encodings.
+func TestLayerTreeBIP340Vectors(t *testing.T) {
+	f, err := os.Open("data/layertree-bip340.csv")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	rows, err := csv.NewReader(f).ReadAll()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, row := range rows[1:] {
+		t.Run(row[0], func(t *testing.T) {
+			decode := func(s string) []byte {
+				b, err := hex.DecodeString(s)
+				if err != nil {
+					t.Fatal(err)
+				}
+				return b
+			}
+			vm := &Engine{taprootCtx: &taprootExecutionCtx{sigOpsBudget: 50}}
+			vm.dstack.PushByteArray(decode(row[5]))
+			vm.dstack.PushByteArray(decode(row[4]))
+			vm.dstack.PushByteArray(decode(row[2]))
+			err := vm.executeLayerTreeOpcode(OP_CHECKSIGFROMSTACK)
+			if (err == nil) != (row[6] == "TRUE") {
+				t.Fatalf("result %v, expected %s: %s", err, row[6], row[7])
+			}
+		})
+	}
+}
