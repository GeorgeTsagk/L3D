@@ -0,0 +1,12 @@
+package blockchain
+
+import "github.com/btcsuite/btcd/txscript"
+
+// ExperimentalScriptFlags supplies the same experimental rules to block
+// validation, mining and the mempool. It is immutable after chain creation.
+func (b *BlockChain) ExperimentalScriptFlags() txscript.ScriptFlags {
+	if b.layerTree {
+		return txscript.ScriptVerifyLayerTree
+	}
+	return 0
+}
