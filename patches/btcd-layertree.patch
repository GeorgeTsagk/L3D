index 00000000..53632759
--- /dev/null
+++ b/txscript/layertree_test.go
@@ -0,0 +1,209 @@
+package txscript
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/csv"
+	"encoding/hex"
+	"os"
+	"testing"
+
+	"github.com/btcsuite/btcd/btcec/v2"
+	"github.com/btcsuite/btcd/btcec/v2/schnorr"
+	"github.com/btcsuite/btcd/wire"
+)
+
+func TestLayerTreeOpcodes(t *testing.T) {
+	priv, pub := btcec.PrivKeyFromBytes([]byte{1})
+	key := schnorr.SerializePubKey(pub)
+	msg := sha256.Sum256([]byte("voucher"))
+	sig, err := schnorr.Sign(priv, msg[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	badMsg := sha256.Sum256([]byte("different voucher"))
+	order, _ := hex.DecodeString("fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141")
+	minusOne, _ := hex.DecodeString("fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364140")
+	one := make([]byte, 32)
+	one[31] = 1
+	_, two := btcec.PrivKeyFromBytes([]byte{2})
+	cases := []struct {
+		name  string
+		op    byte
+		stack [][]byte
+		want  [][]byte
+		fail  bool
+	}{
+		{"cat", OP_CAT, [][]byte{[]byte("ab"), []byte("cd")}, [][]byte{[]byte("abcd")}, false},
+		{"cat empty", OP_CAT, [][]byte{nil, nil}, [][]byte{nil}, false},
+		{"cat limit", OP_CAT, [][]byte{make([]byte, 260), make([]byte, 260)}, [][]byte{make([]byte, 520)}, false},
+		{"cat oversized", OP_CAT, [][]byte{make([]byte, 520), {1}}, nil, true},
+		{"cat underflow", OP_CAT, [][]byte{{1}}, nil, true},
+		{"tweak zero", OP_LAYERTREE_TWEAKADD, [][]byte{make([]byte, 32), key}, [][]byte{key}, false},
+		{"tweak one", OP_LAYERTREE_TWEAKADD, [][]byte{one, key}, [][]byte{schnorr.SerializePubKey(two)}, false},
+		{"tweak order", OP_LAYERTREE_TWEAKADD, [][]byte{order, key}, nil, true},
+		{"tweak infinity", OP_LAYERTREE_TWEAKADD, [][]byte{minusOne, key}, nil, true},
+		{"tweak bad key", OP_LAYERTREE_TWEAKADD, [][]byte{one, bytes.Repeat([]byte{255}, 32)}, nil, true},
+		{"tweak short", OP_LAYERTREE_TWEAKADD, [][]byte{{1}, key}, nil, true},
+		{"tweak underflow", OP_LAYERTREE_TWEAKADD, nil, nil, true},
+		{"csfs", OP_CHECKSIGFROMSTACK, [][]byte{sig.Serialize(), msg[:], key}, [][]byte{{1}}, false},
+		{"csfs wrong message", OP_CHECKSIGFROMSTACK, [][]byte{sig.Serialize(), badMsg[:], key}, nil, true},
+		{"csfs empty sig", OP_CHECKSIGFROMSTACK, [][]byte{nil, msg[:], key}, [][]byte{nil}, false},
+		{"csfs empty key", OP_CHECKSIGFROMSTACK, [][]byte{nil, msg[:], nil}, nil, true},
+		{"csfs malformed", OP_CHECKSIGFROMSTACK, [][]byte{{1}, msg[:], key}, nil, true},
+		{"csfs underflow", OP_CHECKSIGFROMSTACK, [][]byte{key}, nil, true},
+		{"tx input index", OP_LAYERTREE_TX, [][]byte{scriptNum(0x8000).Bytes()}, [][]byte{nil}, false},
+		{"tx input amount", OP_LAYERTREE_TX, [][]byte{scriptNum(0x10800).Bytes()}, [][]byte{{42, 0, 0, 0, 0, 0, 0, 0}}, false},
+		{"tx input script", OP_LAYERTREE_TX, [][]byte{scriptNum(0x20800).Bytes()}, [][]byte{{OP_TRUE}}, false},
+		{"tx output", OP_LAYERTREE_TX, [][]byte{nil, scriptNum(0x4300).Bytes()}, [][]byte{{41, 0, 0, 0, 0, 0, 0, 0}, {OP_TRUE}}, false},
+		{"tx negative index", OP_LAYERTREE_TX, [][]byte{scriptNum(-1).Bytes(), scriptNum(0x4300).Bytes()}, nil, true},
+		{"tx index past end", OP_LAYERTREE_TX, [][]byte{{1}, scriptNum(0x4300).Bytes()}, nil, true},
+		{"tx unknown selector", OP_LAYERTREE_TX, [][]byte{scriptNum(0x100000).Bytes()}, nil, true},
+		{"tx negative selector", OP_LAYERTREE_TX, [][]byte{scriptNum(-1).Bytes()}, nil, true},
+		{"tx nonminimal selector", OP_LAYERTREE_TX, [][]byte{{0, 128, 0, 0}}, nil, true},
+		{"tx underflow", OP_LAYERTREE_TX, nil, nil, true},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			vm := &Engine{flags: ScriptVerifyLayerTree, taprootCtx: &taprootExecutionCtx{sigOpsBudget: 1000}, prevOutFetcher: NewCannedPrevOutputFetcher([]byte{OP_TRUE}, 42)}
+			vm.tx = *wire.NewMsgTx(2)
+			vm.tx.AddTxIn(&wire.TxIn{})
+			vm.tx.AddTxOut(wire.NewTxOut(41, []byte{OP_TRUE}))
+			vm.dstack.verifyMinimalData = true
+			for _, b := range c.stack {
+				vm.dstack.PushByteArray(b)
+			}
+			err := vm.executeLayerTreeOpcode(c.op)
+			if c.fail {
+				if err == nil {
+					t.Fatal("invalid operation accepted")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			got := vm.GetStack()
+			if len(got) != len(c.want) {
+				t.Fatalf("stack size %d want %d", len(got), len(c.want))
+			}
+			for i := range got {
+				if !bytes.Equal(got[i], c.want[i]) {
+					t.Fatalf("stack[%d]=%x want %x", i, got[i], c.want[i])
+				}
+			}
+		})
+	}
+	for _, op := range []byte{OP_LAYERTREE_TWEAKADD, OP_CHECKSIGFROMSTACK} {
+		t.Run("budget", func(t *testing.T) {
+			vm := &Engine{taprootCtx: &taprootExecutionCtx{sigOpsBudget: 49}}
+			if op == OP_CHECKSIGFROMSTACK {
+				vm.dstack.PushByteArray(sig.Serialize())
+				vm.dstack.PushByteArray(msg[:])
+				vm.dstack.PushByteArray(key)
+			} else {
+				vm.dstack.PushByteArray(one)
+				vm.dstack.PushByteArray(key)
+			}
+			if err := vm.executeLayerTreeOpcode(op); err == nil {
+				t.Fatal("budget exhaustion accepted")
+			}
+		})
+	}
+}
