index 614e030c..576248a4 100644
--- a/blockchain/scriptval.go
+++ b/blockchain/scriptval.go
@@ -118,6 +118,22 @@ out:
 // Validate validates the scripts for all of the passed transaction inputs using
 // multiple goroutines.
 func (v *txValidator) Validate(items []*txValidateItem) error {
+	if v.flags&txscript.ScriptVerifyLayerTree != 0 {
+		// CCV amount accounting spans inputs, so validate each experimental
+		// transaction in input order with one fresh context.
+		seen := make(map[*wire.MsgTx]bool)
+		for _, item := range items {
+			tx := item.tx.MsgTx()
+			if seen[tx] {
+				continue
+			}
+			seen[tx] = true
+			if err := txscript.ValidateLayerTreeTransaction(tx, v.utxoView, v.flags, v.sigCache, item.sigHashes); err != nil {
+				return ruleError(ErrScriptValidation, fmt.Sprintf("failed to validate transaction scripts: %v", err))
+			}
+		}
+		return nil
+	}
 	if len(items) == 0 {
 		return nil
 	}
