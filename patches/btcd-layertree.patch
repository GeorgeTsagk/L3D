new file mode 100644
index 00000000..90c3c534
--- /dev/null
+++ b/txscript/layertree.go
@@ -0,0 +1,223 @@
+package txscript
+
+import (
+	"encoding/binary"
+
+	"github.com/btcsuite/btcd/btcec/v2"
+	"github.com/btcsuite/btcd/btcec/v2/schnorr"
+	"github.com/btcsuite/btcd/chaincfg/chainhash"
+)
+
+// LayerTree uses the author's placeholder assignments for conflicting drafts.
+// These are experimental and do not define Bitcoin consensus assignments.
+const (
+	OP_LAYERTREE_EC_ADD    = 0xbb
+	OP_LAYERTREE_EC_MUL    = 0xbc
+	OP_LAYERTREE_EC_NEGATE = 0xbd
+	OP_LAYERTREE_EC_X      = 0xbe
+	OP_LAYERTREE_CCV       = 0xc1
+	OP_LAYERTREE_TX        = 0xbf
+	OP_LAYERTREE_TWEAKADD  = 0xc0
+	OP_CHECKSIGFROMSTACK   = 0xcc
+)
+
+func isLayerTreeOpcode(op byte) bool {
+	return op == OP_CAT || op == OP_LAYERTREE_TX ||
+		op == OP_LAYERTREE_TWEAKADD || op == OP_CHECKSIGFROMSTACK ||
+		op == OP_LAYERTREE_CCV || (op >= OP_LAYERTREE_EC_ADD && op <= OP_LAYERTREE_EC_X)
+}
+
+func (vm *Engine) layerTreeActive() bool {
+	return vm.taprootCtx != nil && vm.hasFlag(ScriptVerifyLayerTree)
+}
+
+func layerTreeError(msg string) error {
+	return scriptError(ErrInvalidStackOperation, "LayerTree: "+msg)
+}
+
+func (vm *Engine) executeLayerTreeOpcode(op byte) error {
+	switch op {
+	case OP_LAYERTREE_CCV:
+		return vm.layerTreeCCV()
+	case OP_LAYERTREE_EC_ADD, OP_LAYERTREE_EC_MUL, OP_LAYERTREE_EC_NEGATE, OP_LAYERTREE_EC_X:
+		return vm.layerTreeEC(op)
+	case OP_CAT:
+		b, err := vm.dstack.PopByteArray()
+		if err != nil {
+			return err
+		}
+		a, err := vm.dstack.PopByteArray()
+		if err != nil {
+			return err
+		}
+		if len(a)+len(b) > vm.layerTreeElementLimit() {
+			return scriptError(ErrElementTooBig, "OP_CAT exceeds element limit")
+		}
+		joined := make([]byte, 0, len(a)+len(b))
+		vm.dstack.PushByteArray(append(append(joined, a...), b...))
+		return nil
+	case OP_LAYERTREE_TX:
+		return vm.layerTreeTx()
+	case OP_LAYERTREE_TWEAKADD:
+		return vm.layerTreeTweakAdd()
+	case OP_CHECKSIGFROMSTACK:
+		return vm.layerTreeCheckSigFromStack()
+	}
+	return layerTreeError("unknown opcode")
+}
+
+// layerTreeTx implements the four OP_TX selectors used by the MID tree
+// scripts. Other draft selectors fail closed in this MVP.
+func (vm *Engine) layerTreeTx() error {
+	selector, err := vm.layerTreeIndex()
+	if err != nil {
+		return err
+	}
+	amount := func(n int64) []byte {
+		var b [8]byte
+		binary.LittleEndian.PutUint64(b[:], uint64(n))
+		return b[:]
+	}
+	switch selector {
+	case 0x8000: // Current input number, minimal CScriptNum.
+		vm.layerTreePushNumber(int64(vm.txIdx))
+	case 0x10800, 0x20800: // Current input amount or scriptPubKey.
+		if vm.prevOutFetcher == nil {
+			return layerTreeError("missing prevout fetcher")
+		}
+		prev := vm.prevOutFetcher.FetchPrevOutput(vm.tx.TxIn[vm.txIdx].PreviousOutPoint)
+		if prev == nil {
+			return layerTreeError("missing prevout")
+		}
+		if selector == 0x10800 {
+			vm.dstack.PushByteArray(amount(prev.Value))
+		} else {
+			if len(prev.PkScript) > vm.layerTreeElementLimit() {
+				return scriptError(ErrElementTooBig, "OP_TX script exceeds element limit")
+			}
+			vm.dstack.PushByteArray(prev.PkScript)
+		}
+	case 0x4300: // Selected output: amount below scriptPubKey.
+		idx, err := vm.layerTreeIndex()
+		if err != nil {
+			return err
+		}
+		if idx < 0 || int64(idx) >= int64(len(vm.tx.TxOut)) {
+			return layerTreeError("output index out of range")
+		}
+		out := vm.tx.TxOut[int(idx)]
+		if len(out.PkScript) > vm.layerTreeElementLimit() {
+			return scriptError(ErrElementTooBig, "OP_TX script exceeds element limit")
+		}
+		vm.dstack.PushByteArray(amount(out.Value))
+		vm.dstack.PushByteArray(out.PkScript)
+	default:
+		return layerTreeError("unsupported OP_TX selector")
+	}
+	return nil
+}
+
+func (vm *Engine) layerTreeTweakAdd() error {
+	key, err := vm.dstack.PopByteArray()
+	if err != nil {
+		return err
+	}
+	tweak, err := vm.dstack.PopByteArray()
+	if err != nil {
+		return err
+	}
+	if len(key) != 32 || len(tweak) != 32 {
+		return layerTreeError("TWEAKADD needs two 32-byte operands")
+	}
+	if err := vm.taprootCtx.tallysigOp(); err != nil {
+		return err
+	}
+	pub, err := schnorr.ParsePubKey(key)
+	if err != nil {
+		return layerTreeError("TWEAKADD invalid public key")
+	}
+	var scalar btcec.ModNScalar
+	if scalar.SetByteSlice(tweak) {
+		return layerTreeError("TWEAKADD scalar overflow")
+	}
+	var p, t, q btcec.JacobianPoint
+	pub.AsJacobian(&p)
+	btcec.ScalarBaseMultNonConst(&scalar, &t)
+	btcec.AddNonConst(&p, &t, &q)
+	if q.Z.IsZero() {
+		return layerTreeError("TWEAKADD point at infinity")
+	}
+	q.ToAffine()
+	vm.dstack.PushByteArray(schnorr.SerializePubKey(btcec.NewPublicKey(&q.X, &q.Y)))
+	return nil
+}
+
+func (vm *Engine) layerTreeCheckSigFromStack() error {
+	key, err := vm.dstack.PopByteArray()
+	if err != nil {
+		return err
+	}
+	msg, err := vm.dstack.PopByteArray()
+	if err != nil {
+		return err
+	}
+	sig, err := vm.dstack.PopByteArray()
+	if err != nil {
+		return err
+	}
+	if len(key) == 0 {
+		return scriptError(ErrTaprootPubkeyIsEmpty, "CSFS empty public key")
+	}
+	if len(sig) == 0 {
+		vm.dstack.PushBool(false)
+		return nil
+	}
+	if err := vm.taprootCtx.tallysigOp(); err != nil {
+		return err
+	}
+	if len(key) != 32 {
+		if vm.hasFlag(ScriptVerifyDiscourageUpgradeablePubkeyType) {
+			return layerTreeError("CSFS unknown public key type")
+		}
+		vm.dstack.PushBool(true)
+		return nil
+	}
+	pub, err := schnorr.ParsePubKey(key)
+	if err != nil {
+		return layerTreeError("CSFS invalid public key")
+	}
+	if !layerTreeVerifySignature(sig, msg, pub) {
+		return scriptError(ErrNullFail, "CSFS signature failed")
+	}
+	vm.dstack.PushBool(true)
+	return nil
+}
+
+// The pinned btcec verifier only accepts 32-byte messages. BIP348 permits
+// arbitrary messages, so use the BIP340 group equation with the same curve
+// primitives and strict signature parser for CSFS.
+func layerTreeVerifySignature(sig, msg []byte, pub *btcec.PublicKey) bool {
+	if _, err := schnorr.ParseSignature(sig); err != nil {
+		return false
+	}
+	eHash := chainhash.TaggedHash(chainhash.TagBIP0340Challenge,
+		sig[:32], schnorr.SerializePubKey(pub), msg)
+	var e, s btcec.ModNScalar
+	e.SetByteSlice(eHash[:])
+	e.Negate()
+	s.SetByteSlice(sig[32:])
+	var p, sg, ep, r btcec.JacobianPoint
+	pub.AsJacobian(&p)
+	btcec.ScalarBaseMultNonConst(&s, &sg)
+	btcec.ScalarMultNonConst(&e, &p, &ep)
+	btcec.AddNonConst(&sg, &ep, &r)
+	if r.Z.IsZero() {
+		return false
+	}
+	r.ToAffine()
+	var want btcec.FieldVal
+	if want.SetByteSlice(sig[:32]) {
+		return false
+	}
+	return !r.Y.IsOdd() && r.X.Equals(&want)
+}
